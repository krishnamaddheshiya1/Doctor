{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,manga/**,*.html,*.css,*.js,*.jpg,*.png,*.jpeg,backend/**}"
    },
    "backend/server.js": {
      "includeFiles": "{public/**,manga/**,*.html,*.css,*.js,*.jpg,*.png,*.jpeg,backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/manga",
      "destination": "/manga/index.html"
    },
    {
      "source": "/manga/(.*)",
      "destination": "/manga/$1"
    },
    {
      "source": "/admin",
      "destination": "/manga/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/manga/$1"
    }
  ]
}