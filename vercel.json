{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,*.html,*.css,*.js,*.jpg,*.png,*.jpeg,backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ]
}
