{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{public/**,manga/**,*.html,*.css,*.js,*.jpg,*.png,*.jpeg,backend/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js?__route=/api"
    },
    {
      "source": "/api/",
      "destination": "/api/index.js?__route=/api/"
    },
    {
      "source": "/api/orders",
      "destination": "/api/index.js?__route=/api/orders"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "/api/index.js?__route=/api/orders/$1"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.js?__route=/api/health"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/index.js?__route=/api/dashboard"
    },
    {
      "source": "/api/manga",
      "destination": "/api/index.js?__route=/api/manga"
    },
    {
      "source": "/api/manga/(.*)",
      "destination": "/api/index.js?__route=/api/manga/$1"
    },
    {
      "source": "/api/admin",
      "destination": "/api/index.js?__route=/api/admin"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/index.js?__route=/api/admin/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__route=/api/$1"
    },
    {
      "source": "/orders",
      "destination": "/api/index.js?__route=/orders"
    },
    {
      "source": "/orders/(.*)",
      "destination": "/api/index.js?__route=/orders/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.js?__route=/health"
    },
    {
      "source": "/dashboard",
      "destination": "/api/index.js?__route=/dashboard"
    },
    {
      "source": "/manga",
      "destination": "/api/index.js?__route=/manga"
    },
    {
      "source": "/manga/(.*)",
      "destination": "/api/index.js?__route=/manga/$1"
    },
    {
      "source": "/admin",
      "destination": "/api/index.js?__route=/admin"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index.js?__route=/admin/$1"
    },
    {
      "source": "/admin.html",
      "destination": "/api/index.js?__route=/admin.html"
    }
  ]
}